# ============================================================
#  X CORP SHOP — пример конфигурации. Скопируй в .env и заполни.
# ============================================================

# Токен бота от @BotFather (ОБЯЗАТЕЛЬНО)
BOT_TOKEN=

# ID администраторов через запятую
ADMIN_IDS=123456789

# Логи в Telegram-группу (id группы; если форум — добавь LOG_TOPIC_ID)
LOG_CHAT_ID=
LOG_TOPIC_ID=

# Час суточной статистики по времени сервера (0-23)
LOG_DAILY_HOUR=12

# Бэкапы БД: часы отправки (2 раза в сутки) и сколько копий хранить
BACKUP_HOURS=6,18
BACKUP_KEEP=7

# Автоотмена неоплаченных заказов через N часов
AUTO_CANCEL_HOURS=3

# Папка для базы данных. По умолчанию — data рядом с ботом.
# УКАЖИ путь, который на твоём хостинге переживает перезапуск!
# DATA_DIR=/app/data

# Платежи
CRYPTO_BOT_TOKEN=
XROCKET_TOKEN=

# Канал и поддержка

# Реферальный процент по умолчанию
